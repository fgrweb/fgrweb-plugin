<?xml version="1.0"?>
<ruleset name="Fgrweb Plugin">
	<description>Estándar WordPress para el plugin. Excluye librerías de terceros.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<exclude-pattern>*/includes/updater-checker/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<rule ref="WordPress"/>

	<!-- Los index.php de "Silence is golden" no necesitan docblock de fichero. -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/index.php</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
